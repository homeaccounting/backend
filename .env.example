# Runtime Environment Configuration for Accounting Backend
# Copy this file to `.env` and fill in real values. `.env` is sourced by
# .envrc (via direnv) and consumed by config/*.yaml. `.env` is gitignored;
# this `.env.example` is the committed template.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Path to the YAML config file (default: config/local.yaml)
CONFIG_FILE=config/local.yaml

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=accounting
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# IMPORTANT: Change this in production!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_IN_PRODUCTION

# ---------------------------------------------------------------------------
# OAuth2 Providers (optional — leave empty to disable)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Telegram Bot (optional — leave empty to disable)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# ---------------------------------------------------------------------------
# Banking
# ---------------------------------------------------------------------------
BANKING_ENABLED=true
BANKING_MONOBANK_ENABLED=true
BANKING_PRIVATBANK_ENABLED=true
BANKING_PRIVATBANK_BUSINESS_ENABLED=true
# Base64-encoded 32-byte key used to encrypt persisted bank-connection access
# tokens (AES-256-GCM). REQUIRED when banking is enabled in production —
# startup fails fast if it is unset or does not decode to exactly 32 bytes.
# Generate one with: openssl rand -base64 32
BANKING_TOKEN_ENC_KEY=

# ---------------------------------------------------------------------------
# LLM — natural-language transaction prompting (optional; opt-in)
# ---------------------------------------------------------------------------
# Uses a free, external OpenAI-compatible endpoint (default: Groq). Set
# LLM_ENABLED=true and provide an API key to turn on POST /api/prompt.
# Fully swappable via LLM_BASE_URL / LLM_MODEL (any OpenAI-compatible provider:
# Groq, OpenRouter, a self-hosted Ollama, etc.).
LLM_ENABLED=false
# Free key from https://console.groq.com (required when LLM_ENABLED=true):
LLM_API_KEY=
# Overrides (defaults target Groq's free tier):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# API test fixtures (test-only credentials, Monobank tokens, etc.) live in
# scripts/api-test/.env so they don't leak into the app process. See
# scripts/api-test/.env.example.
# ---------------------------------------------------------------------------
