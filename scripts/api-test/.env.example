# API Test Environment Variables (template)
# Copy this file to scripts/api-test/.env and fill in real values.
# Loaded by common.sh after the project-root .env — does not leak into the
# app process when you `cabal run` / `just run`.

# ---------------------------------------------------------------------------
# Telegram User Identity (for test-telegram.sh login)
# Find your Telegram user ID by messaging @userinfobot on Telegram.
# ---------------------------------------------------------------------------
TELEGRAM_USER_ID=
TELEGRAM_FIRST_NAME=
TELEGRAM_USERNAME=

# ---------------------------------------------------------------------------
# Monobank (for test-banking.sh)
# ---------------------------------------------------------------------------
MONOBANK_TOKEN=
MONOBANK_IBAN=

# ---------------------------------------------------------------------------
# API Test Credentials (optional)
# When set, scripts/api-test/* reuse these instead of generating a fresh user
# per run. Useful for testing against an already-registered account.
# Leave unset (or commented) to generate unique credentials each run.
# ---------------------------------------------------------------------------
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_USER2_EMAIL=
# TEST_USER2_PASSWORD=
