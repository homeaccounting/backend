cabal-version: 3.0
name: accounts
version: 0.1.0.0
synopsis: Accounting system backend with CQRS and Event Sourcing
description: A REST API for an accounting system built with CQRS and Event Sourcing patterns
license: MIT
author: Developer
maintainer: developer@example.com
category: Finance
build-type: Simple

executable accounts
  main-is: Main.hs
  other-modules:
    Domain.Account
    Domain.Events
    Domain.Commands
    Infrastructure.EventStore
    Application.CommandHandlers
    Application.QueryHandlers
    Web.API
    Web.Server
  build-depends:
    base ^>=4.17.0.0,
    servant,
    servant-server,
    warp,
    aeson,
    uuid,
    containers,
    time,
    text,
    mtl,
    stm,
    bytestring,
    wai,
    wai-cors
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wredundant-constraints 